# =============================================================
#  Crypto Quest Bot — configuration (sellable template)
#  Copy this file to `.env` and fill in YOUR OWN values.
#  Do NOT commit .env to git.
# =============================================================

# --- Telegram bot ---
# Get a token from @BotFather (https://t.me/BotFather -> /newbot).
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Payment: wallet address (manual crypto payment) ---
# This is where payments go. Buyer sets their own EVM wallet.
# Same address works for BSC (BEP-20), Ethereum (ERC-20), Polygon (MATIC).
CRYPTO_ADDRESS=0xYourWalletAddressHere

# --- Payment: NOWPayments (optional, automatic card/crypto gateway) ---
# Register at https://nowpayments.io, get an API key from Settings -> API Keys.
# Money settles to the payout wallet you set in your NOWPayments dashboard.
# Leave empty to disable the NOWPayments button.
NOWPAYMENTS_API_KEY=

# --- Payment: CoinGate (optional, hosted web payment page) ---
# Register at https://coingate.com, set a payout crypto wallet, then get an
# Auth Token from Settings -> API -> Create Auth Token. Gives customers a
# web payment page to pay with 70+ coins. Leave empty to hide the button.
COINGATE_AUTH_TOKEN=

# --- Price ---
# Monthly price in USD for the Premium plan.
PRICE_USD=5

# --- Admin / Owner ---
# Your Telegram chat_id (for receiving payment alerts AND owner commands).
# Get it from @userinfobot. Set this to use the owner admin panel.
# OWNER_CHAT_ID=

# --- VIP Channel (optional, Phase 2 auto-membership) ---
# Make the bot an ADMIN of your channel, then set its id and (optionally) a
# public invite link. When set, paying customers automatically get channel
# access, and expired subscriptions are auto-kicked.
# CHANNEL_ID=-1001234567890
# CHANNEL_LINK=https://t.me/yourchannel

# --- Website & Support (shown to customers in the main menu) ---
# Set your official website and a support contact (e.g. t.me/yourusername)
# so customers can reach you. Leave empty to hide those menu buttons.
WEBSITE_URL=https://example.com
SUPPORT_URL=https://t.me/yourusername