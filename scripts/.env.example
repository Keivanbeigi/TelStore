# =============================================================
#  Crypto Quest Bot — configuration (sellable template)
#  Copy this file to `.env` and fill in YOUR OWN values.
#  Do NOT commit .env to git.
# =============================================================

# --- Telegram bot ---
# Get a token from @BotFather (https://t.me/BotFather -> /newbot).
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Payment: wallet address (manual crypto payment) ---
# This is where payments go. Buyer sets their own EVM wallet.
# Same address works for BSC (BEP-20), Ethereum (ERC-20), Polygon (MATIC).
CRYPTO_ADDRESS=0xYourWalletAddressHere

# --- Payment: NOWPayments (optional, automatic card/crypto gateway) ---
# Register at https://nowpayments.io, get an API key from Settings -> API Keys.
# Money settles to the payout wallet you set in your NOWPayments dashboard.
# Leave empty to disable the NOWPayments button.
NOWPAYMENTS_API_KEY=

# --- Price ---
# Monthly price in USD for the Premium plan.
PRICE_USD=5

# --- Admin ---
# Your Telegram chat_id (for receiving payment alerts). Get it from @userinfobot.
# OWNER_CHAT_ID=